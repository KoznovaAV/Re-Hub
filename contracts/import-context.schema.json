{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "file_kind": {
      "enum": [
        "clients",
        "snapshot"
      ]
    },
    "key_mode": {
      "enum": [
        "anonymous",
        "kcr"
      ]
    },
    "mapping_profile": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "period_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9_]{1,40}$"
      }
    },
    "coverage": {
      "enum": [
        "unknown",
        "full_declared"
      ]
    },
    "supersedes_snapshot_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "contract_version",
    "file_kind",
    "key_mode",
    "mapping_profile"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rehub:import-context:v1",
  "allOf": [
    {
      "if": {
        "properties": {
          "file_kind": {
            "const": "snapshot"
          }
        }
      },
      "then": {
        "required": [
          "snapshot_date",
          "period_scope",
          "coverage"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "file_kind": {
            "const": "clients"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "snapshot_date"
              ]
            },
            {
              "required": [
                "period_scope"
              ]
            },
            {
              "required": [
                "coverage"
              ]
            },
            {
              "required": [
                "supersedes_snapshot_id"
              ]
            }
          ]
        }
      }
    }
  ]
}
